#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * `drift` —— 统一开发入口（对标 `flutter` / `ng` 这类「一个 CLI + 子命令」）。
 *
 * ★ 只做路由，**不实现判据**：验证统一转发 `tests/Verify/verify.php`
 *   （计划住 `tests/Verify/VerifyPlan.php`，`--list` 是唯一事实源）；
 *   PHPUnit 单跑转发 `tools/phpunit-run.php`。
 *   S4 起 V1 gate 已退役，`check` / `list` / `tooling` 只是历史脚本名的别名，
 *   一律转发 V2 runner，不再有第二份清单或第二个执行器。
 *
 * ★ 为什么要有它：此前 70 个顶层 CLI 各自 `require autoload` + 解析 `$argv` +
 *   `exit()`，开发者得记住「改了 X 该跑哪条」。`composer run --list` 现在是
 *   唯一可发现入口，`composer.json` 的 scripts 全部转发到这里。
 *
 * ★ 手工工具（8 个）也是子命令，但**不进 `VerifyPlan`**：它们是 AOT / 双模等价、
 *   预览、字模与报告生成这类「按需调用、要特定环境」的开发工具，不是判据通道；
 *   把它们塞进 `--list` 只会让 CI 清单多出 8 条没人跑的项。
 *   `dual-mode-fingerprint-entry.php` 故意不路由 —— 它由 `DRIFT_DEV_ENTRY` 指向，
 *   是被 dev.exe 加载的无头入口，不是给人敲的命令。
 *
 * ★ 三形态口径不因这个 CLI 而模糊：
 *   interpreter —— check / verify / test / lint / list（T0，无头、CI 可跑）
 *   dev-shell   —— dev（T1，真窗口 + 动态 PHP，秒级重启）
 *   aot         —— build / probe（T2，真机，不可替代前两档）
 *   详见 `docs/guides/testing.md`。
 *
 * ★ 数组式 `proc_open` + `bypass_shell`：php.exe 走 shell 时 Windows 会经
 *   cmd.exe 二次解释带空格的路径与引号（与 drift-build.php 同法）。
 */
require dirname(__DIR__) . '/tools/autoload.php';

$root = dirname(__DIR__);
$args = array_slice($argv, 1);
$name = $args[0] ?? 'help';
$rest = array_slice($args, 1);

/** @return list<string> */
$build = static function (string $script, array $rest, string $root): array {
    return [PHP_BINARY, $root . '/tools/' . $script, ...$rest];
};

$verify = [PHP_BINARY, $root . '/tests/Verify/verify.php'];

/**
 * `drift debug <verb> …` —— 十一个调试出口共用一个动词。
 *
 * 它们共享同一套驱动词表（`--page` / `--frames` / `--click` / `--hold` …），
 * 只有"问什么"不同。平级子命令时这套词表要背八遍，且拼错一个只能靠
 * "未知参数"报错猜；收进一个动词后，`drift debug` 本身就是可发现的地方。
 *
 * `host` / `serve` / `ctl` 是个例外：前两个不开会话，第三个接别人的会话，
 * 所以它们不认驱动词表（`ctl` 认的是 `--session` / `--frames`）。
 *
 * 无 verb（或第一项是选项）时退化成 `report`：`drift debug --page=table` 这类
 * 既有写法继续工作 —— 收敛入口不该顺手把人的肌肉记忆废掉。
 */
$debug = static function (array $rest, string $root): array {
    $verbs = [
        'brief' => ['debug-brief.php', '预算内的证据简报：哪里不对、为什么、下一步查哪'],
        'report' => ['debug-report.php', '帧因果报告：哪些节点重建了、因为谁'],
        'panel' => ['debug-panel.php', '同一个会话上反复追问：时间轴 + 因果树 + 原因'],
        'network' => ['debug-network.php', '网络骨架与报文（按 requestId 取，脱敏 + 截断）'],
        'node' => ['debug-node.php', '一个节点的三域对齐：因果 / 几何 / 网络'],
        'pick' => ['debug-pick.php', '按视口坐标点选，给命中链与每层路径'],
        'props' => ['debug-props.php', '按节点读 Widget / State 配置'],
        'host' => ['debug-host.php', '宿主进程（被 --remote 拉起，也可手工对着 stdio 发消息）'],
        'serve' => ['debug-serve.php', '常驻宿主：自己按脚本推帧，等人 attach 上来看'],
        'ctl' => ['debug-ctl.php', '控制面：让自走的宿主停一下 / 走一步 / 接着跑'],
        'web' => ['debug-web.php', '浏览器视图：同一份证据的第三个消费者（几何画布 + 发现）'],
    ];

    $list = static function (array $verbs): void {
        fwrite(STDOUT, "drift debug <verb> [options]\n\n");
        foreach ($verbs as $name => [$script, $about]) {
            fwrite(STDOUT, \sprintf("  %-8s %s\n", $name, $about));
        }
        fwrite(STDOUT, "\ndrift debug <verb> --help 看各自的用法；省略 <verb> 等同 report。\n");
    };

    /**
     * 用法直接从脚本的文档块里取，不在这里另抄一份。
     *
     * 抄一份就会漂：加了参数忘了改这里，`--help` 就成了一份过期的说明书 ——
     * 而"文档说支持、实际不支持"比没有 `--help` 更费时间。
     */
    $usage = static function (string $file): string {
        $src = @\file_get_contents($file);
        if ($src === false) {
            return "（读不到脚本文件：{$file}）\n";
        }
        if (\preg_match('/\n \* (用法：(?:\n \* .*)*)/', $src, $m) !== 1) {
            return "（这个脚本的文档块里没有「用法：」段）\n";
        }

        $out = [];
        foreach (\explode("\n", \rtrim($m[1])) as $line) {
            $out[] = (string) \preg_replace('/^ \* ?/', '', $line);
        }

        return \implode("\n", $out) . "\n\n完整参数见 " . \str_replace('\\', '/', $file) . "\n";
    };

    $verb = $rest[0] ?? '';

    if ($verb === 'help' || $verb === '--help' || $verb === '-h') {
        $list($verbs);
        exit(0);
    }

    if (isset($verbs[$verb])) {
        $file = $root . '/tools/' . $verbs[$verb][0];
        $next = $rest[1] ?? '';
        if ($next === '--help' || $next === '-h') {
            fwrite(STDOUT, $usage($file));
            exit(0);
        }

        return [PHP_BINARY, $file, ...array_slice($rest, 1)];
    }

    if ($verb === '' || \str_starts_with($verb, '-')) {
        return [PHP_BINARY, $root . '/tools/debug-report.php', ...$rest];
    }

    // 拼错的 verb 落到这里：列出可用动词，而不是替人猜一个。
    $list($verbs);
    exit(2);
};

$cmd = match ($name) {
    // S4：V1 gate 已退役，三个历史脚本名作别名一律转发 V2 runner。
    //     V1 专有参数（--fast / --only=… / --group=…）不再存在，传入由 verify 判为未知参数。
    'check'   => [...$verify, ...$rest],
    'list'    => [...$verify, '--list'],
    'tooling' => [...$verify, '--layer=static', ...$rest],
    'test' => $build('phpunit-run.php', $rest === [] ? ['unit'] : $rest, $root),
    // V2 验证入口：执行器住 tests/Verify/，判据清单只有 VerifyPlan 一份。
    'verify' => [...$verify, ...$rest],
    'lint' => $build('lint.php', $rest, $root),
    'dev' => $build('drift-dev.php', $rest, $root),
    'build' => $build('drift-build.php', $rest, $root),
    'probe' => [
        (string) (getenv('DRIFT_PYTHON') ?: 'python'),
        $root . '/tools/probe-window.py',
        ...$rest,
    ],
    // 调试：一个动词 + 十一个出口，见 $debug。下面两个平级名（`panel` / `brief`）
    // 是收敛前的旧入口，过渡期保留薄转发，下一轮删。
    'debug' => $debug($rest, $root),
    'panel' => $build('debug-panel.php', $rest, $root),
    'brief' => $build('debug-brief.php', $rest, $root),
    // 帧因果的宿主进程：由 `debug --remote` 起，也可手工对着 stdio 发消息。
    'debug-host' => $build('debug-host.php', $rest, $root),
    // 手工工具：按需调用，不进 VerifyPlan / CI。
    'codegen'       => $build('drift-codegen.php', $rest, $root),
    'preview'       => $build('drift-preview.php', $rest, $root),
    'aot-equiv'     => $build('aot-equivalence.php', $rest, $root),
    'dual-equiv'    => $build('dual-mode-equivalence.php', $rest, $root),
    'fingerprint'   => $build('fingerprint.php', $rest, $root),
    'font-scan'     => $build('font-scan-chars.php', $rest, $root),
    'golden-report' => $build('golden-report.php', $rest, $root),
    'grab'          => $build('build-grab.php', $rest, $root),
    default => null,
};

if ($cmd === null && $name !== 'help') {
    fwrite(STDERR, "未知子命令：{$name}\n\n");
    $name = 'help';
    $exitOnHelp = 2;
} else {
    $exitOnHelp = 0;
}

if ($name === 'help' || $cmd === null) {
    fwrite(STDOUT, <<<'TXT'
drift —— 统一开发入口

  composer check           V2 日常验证（历史别名，等价于 composer verify）
  composer check:full      V2 全量（历史别名，等价于 composer verify:full）
  composer test            PHPUnit unit；composer test -- feature 跑场景
  composer tooling         V2 static 层（历史别名；单点用 verify -- --step=<id>）
  composer lint            lint 全量
  composer checks          当前 V2 判据清单（--list，唯一权威）
  composer verify          V2 日常验证（static + behavior 快项）
  composer verify:full     V2 CI 口径；verify -- --list 看分层计划
  composer dev -- <app>    T1 开发态壳（动态 PHP、真窗口、免重编译）
  composer build -- <app> --full   T2 AOT 构建
  composer probe -- <app>  T2 真机探针

  手工工具（按需调用，不进 V2 判据清单 / CI）
  composer preview -- --page=<Widget 的 php>   T0 无头 layout+paint → SVG/PNG
  composer debug -- <verb> …                  调试出口总入口（省略 <verb> 等同 report）
        brief    预算内的证据简报：哪里不对、为什么、下一步查哪
        report   帧因果报告：哪些节点重建了、因为谁（旧写法 `--page=…` 仍可用）
        panel    同一个会话上反复追问：时间轴 + 因果树 + 原因
        network  网络骨架与报文（按 requestId，脱敏 + 截断）
        node     一个节点的三域对齐：因果 / 几何 / 网络
        pick     按视口坐标点选，给命中链与每层路径
        props    按节点读 Widget / State 配置
        host     宿主进程（调试协议另一端，通常由 --remote 起）
        serve    常驻宿主：自己推帧，另一个终端用 `brief --attach` 看
        ctl      控制面：pause / resume / state（单步用 resume --frames=1）
        web      浏览器视图：端口上开一个页面，画布按几何画盒、左边列发现
     旧名 composer panel / composer brief / composer debug-host 过渡期仍是别名
  composer codegen                            T1 tpc 翻译层门（秒级，不编译）
  composer aot-equiv                          T2 解释器 ↔ 全 AOT 逐值几何等价
  composer dual-equiv                         T2 解释器 ↔ dev 壳逐值语义等价
  composer fingerprint                        解释器侧 27 页双通道指纹
  composer font-scan                          扫字面量非 ASCII 字符集（字模生成）
  composer golden-report                      golden 失败现场 HTML（先量再呈现）
  composer grab                               重建 tools/probe-grab.exe（需 MSVC）

  composer run --list      看全部 scripts 及说明

环境依赖：`composer probe`（真机探针）需要 Python 3，可用 DRIFT_PYTHON 指定解释器；
重生成字模（`tools/font-gen-*.py`，手工调用）另外需要 Pillow。日常 verify / test /
lint 只依赖 PHP + composer vendor（PHPUnit）；`composer build` 要的是
MSVC + SDK + tpc，与 Python 无关。

形态不能互相替代：dev 绿 ≠ AOT 绿；T2 的 DPI / WIC / UIA / 消息循环
只能靠真机探针。分层见 docs/guides/testing.md。

TXT);
    exit($exitOnHelp);
}

$proc = proc_open(
    $cmd,
    [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
    $pipes,
    $root,
    null,
    ['bypass_shell' => true],
);
if (!is_resource($proc)) {
    fwrite(STDERR, "启动失败：{$cmd[0]}\n");
    if ($name === 'probe') {
        fwrite(STDERR, "找不到 python 时设 DRIFT_PYTHON=<解释器路径>；这是「没测到」，不是通过。\n");
    }
    exit(127);
}
fclose($pipes[0]);
stream_set_blocking($pipes[1], false);
stream_set_blocking($pipes[2], false);

$code = -1;
while (true) {
    $status = proc_get_status($proc);
    $out = (string) stream_get_contents($pipes[1]);
    $err = (string) stream_get_contents($pipes[2]);
    if ($out !== '') {
        fwrite(STDOUT, $out);
    }
    if ($err !== '') {
        fwrite(STDERR, $err);
    }
    if (!$status['running']) {
        $code = (int) $status['exitcode'];
        break;
    }
    usleep(20000);
}
fwrite(STDOUT, (string) stream_get_contents($pipes[1]));
fwrite(STDERR, (string) stream_get_contents($pipes[2]));
fclose($pipes[1]);
fclose($pipes[2]);
proc_close($proc);

exit($code === -1 ? 1 : $code);
