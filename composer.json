{
  "name": "drift/drift",
  "description": "Drift —— 用 TypePHP 写的声明式 GUI 框架",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.4"
  },
  "autoload": {
    "psr-4": {
            "Drift\\": "src/",
            "Drift\\Dev\\": "tools/",
            "Drift\\Dev\\Tests\\": "tests/",
      "App\\Hello\\": [
        "apps/hello/src/",
        "apps/hello/bin/win32/",
        "apps/hello/bin/macos/"
      ],
      "App\\Users\\": [
        "apps/users/src/",
        "apps/users/bin/win32/",
        "apps/users/bin/macos/"
      ],
      "App\\Showcase\\": [
        "apps/showcase/src/",
        "apps/showcase/bin/win32/",
        "apps/showcase/bin/macos/"
      ],
      "App\\Tutorial\\": [
        "apps/tutorial/src/",
        "apps/tutorial/bin/win32/",
        "apps/tutorial/bin/macos/"
      ],
      "App\\Watermark\\": [
        "apps/watermark/src/",
        "apps/watermark/bin/win32/",
        "apps/watermark/bin/macos/"
      ]
    }
  },
  "scripts": {
    "check": "@php bin/drift check",
    "check:full": "@php bin/drift check --full",
    "checks": "@php bin/drift list",
    "test": "@php bin/drift test",
    "tooling": "@php bin/drift tooling",
    "lint": "@php bin/drift lint",
    "dev": "@php bin/drift dev",
    "build": "@php bin/drift build",
    "probe": "@php bin/drift probe"
  },
  "scripts-descriptions": {
    "check": "T0 日常闸门（gate --fast，跳过慢项）",
    "check:full": "T0 全量闸门（含 feature / pages / smoke）",
    "checks": "当前判据清单 —— 唯一权威，别把项数抄进文档",
    "test": "PHPUnit unit（缺 PHPUnit 时 exit 2，不算通过）",
    "tooling": "工具链对账组；-- --only=abi 可单跑组内判据，-- --selftest 只验自证",
    "lint": "lint 全量规则",
    "dev": "T1 开发态壳：动态 PHP + 真窗口，免重编译",
    "build": "T2 AOT 构建（需完整工具链）",
    "probe": "T2 真机探针（需 python，DRIFT_PYTHON 可覆盖）"
  }
}
