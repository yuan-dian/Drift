{
  "name": "drift/drift",
  "description": "Drift —— 用 TypePHP 写的声明式 GUI 框架",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.4"
  },
  "autoload": {
    "psr-4": {
            "Drift\\": "src/",
            "Drift\\Dev\\": "tools/",
            "Drift\\Dev\\Tests\\": "tests/",
      "App\\Hello\\": [
        "apps/hello/src/",
        "apps/hello/bin/win32/",
        "apps/hello/bin/macos/"
      ],
      "App\\Users\\": [
        "apps/users/src/",
        "apps/users/bin/win32/",
        "apps/users/bin/macos/"
      ],
      "App\\Showcase\\": [
        "apps/showcase/src/",
        "apps/showcase/bin/win32/",
        "apps/showcase/bin/macos/"
      ],
      "App\\Tutorial\\": [
        "apps/tutorial/src/",
        "apps/tutorial/bin/win32/",
        "apps/tutorial/bin/macos/"
      ]
    }
  }
}
